@model List<FeyzaStore.MVC.Models.ProductViewModel>

@{
    ViewData["Title"] = "Ürün Yönetimi";
}

<div class="container mt-5">

    <h2>Ürün Yönetimi</h2>

    <a asp-area="Admin"
       asp-controller="Product"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Yeni Ürün Ekle
    </a>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Id</th>
                <th>Ürün Adı</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>Kategori</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var product in Model)
            {
                <tr>

                    <td>@product.Id</td>

                    <td>@product.Name</td>

                    <td>
                        @product.Price.ToString("N2") TL
                    </td>

                    <td>@product.Stock</td>

                    <td>@product.CategoryName</td>

                    <td>

                        <a asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Edit"
                           asp-route-id="@product.Id">
                            Güncelle
                        </a>

                        |
                        |

<a asp-area="Admin"
   asp-controller="Product"
   asp-action="UploadImage"
   asp-route-id="@product.Id">
    Resim Yükle
</a>

                        <form asp-area="Admin"
                              asp-controller="Product"
                              asp-action="Delete"
                              asp-route-id="@product.Id"
                              method="post"
                              style="display:inline;">

                            <button type="submit"
                                    onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?')">
                                Sil
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>