@model List<FeyzaStore.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="container mt-5">

    <h2>Kategori Yönetimi</h2>

    <a asp-area="Admin"
       asp-controller="Category"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Yeni Kategori Ekle
    </a>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Id</th>
                <th>Kategori Adı</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                  <td>
 <a asp-area="Admin"
   asp-controller="Category"
   asp-action="Edit"
   asp-route-id="@category.Id">
    Güncelle
</a>
|

    <form asp-area="Admin"
          asp-controller="Category"
          asp-action="Delete"
          asp-route-id="@category.Id"
          method="post"
          style="display:inline;">

        <button type="submit"
                onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">
            Sil
        </button>

    </form>
</td>
                </tr>
            }

        </tbody>

    </table>

</div>