@{
    ViewData["Title"] = "İletişim";
}

<!-- Başlık -->
<section class="bg-light py-5">
    <div class="container text-center">

        <h1 class="fw-bold mb-3">
            İletişim
        </h1>

        <p class="text-muted fs-5">
            Sorularınız için bizimle iletişime geçebilirsiniz.
        </p>

    </div>
</section>


<!-- İletişim Bilgileri -->
<section class="py-5">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-5 text-center">

                        <h2 class="fw-bold mb-4">
                            Bize Ulaşın
                        </h2>

                        <p class="text-muted mb-5">
                            FeyzaStore hakkında merak ettikleriniz,
                            ürünlerimiz veya siparişlerinizle ilgili
                            sorularınız için bize ulaşabilirsiniz.
                        </p>


                        <div class="row g-4">

                            <!-- E-posta -->
                            <div class="col-md-4">

                                <div class="p-3">

                                    <h5 class="fw-bold text-success">
                                        E-posta
                                    </h5>

                                    <p class="text-muted mb-0">
                                        info@feyzastore.com
                                    </p>

                                </div>

                            </div>


                            <!-- Telefon -->
                            <div class="col-md-4">

                                <div class="p-3">

                                    <h5 class="fw-bold text-success">
                                        Telefon
                                    </h5>

                                    <p class="text-muted mb-0">
                                        +90 555 555 55 55
                                    </p>

                                </div>

                            </div>


                            <!-- Konum -->
                            <div class="col-md-4">

                                <div class="p-3">

                                    <h5 class="fw-bold text-success">
                                        Konum
                                    </h5>

                                    <p class="text-muted mb-0">
                                        İstanbul, Türkiye
                                    </p>

                                </div>

                            </div>

                        </div>


                        <hr class="my-5" />


                        <!-- Çalışma Saatleri -->
                        <h5 class="fw-bold text-success">
                            Çalışma Saatleri
                        </h5>

                        <p class="text-muted mb-0">
                            Pazartesi - Cuma<br />
                            09:00 - 18:00
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- Alt Alan -->
<section class="bg-success text-white py-5">

    <div class="container text-center">

        <h2 class="fw-bold mb-3">
            FeyzaStore
        </h2>

        <p class="mb-0">
            Tarzını keşfet, sana uygun parçayı bul.
        </p>

    </div>

</section>