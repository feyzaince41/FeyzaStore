@{
    ViewData["Title"] = "Hakkımızda";
}

<!-- Hakkımızda Başlık -->
<section class="bg-light py-5">
    <div class="container">

        <div class="row justify-content-center text-center">

            <div class="col-lg-8">

                <h1 class="fw-bold mb-3">
                    Hakkımızda
                </h1>

                <p class="text-muted fs-5">
                    Tarzınızı tamamlayan parçaları
                    FeyzaStore'da keşfedin.
                </p>

            </div>

        </div>

    </div>
</section>


<!-- FeyzaStore Hakkında -->
<section class="py-5">
    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Sol Taraf -->
            <div class="col-lg-6">

                <h2 class="fw-bold mb-4">
                    FeyzaStore'u Keşfedin
                </h2>

                <p class="text-muted">
                    FeyzaStore; kadın giyim, erkek giyim ve
                    aksesuar ürünlerini bir araya getiren
                    modern bir online alışveriş platformudur.
                </p>

                <p class="text-muted">
                    Amacımız, günlük kullanımdan özel anlara
                    kadar farklı tarzlara hitap eden ürünleri
                    sade ve kolay bir alışveriş deneyimiyle
                    kullanıcılarımızla buluşturmaktır.
                </p>

                <p class="text-muted">
                    Modern tasarım, kolay kullanım ve güvenli
                    alışveriş anlayışı FeyzaStore'un temelini
                    oluşturur.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-success px-4 mt-2">

                    Ürünleri Keşfet

                </a>

            </div>


            <!-- Sağ Taraf -->
            <div class="col-lg-6">

                <div class="bg-light rounded-4 p-5 shadow-sm">

                    <div class="mb-4">
                        <h4 class="text-success fw-bold">
                            Geniş Ürün Seçeneği
                        </h4>

                        <p class="text-muted mb-0">
                            Kadın, erkek ve aksesuar
                            kategorilerinde farklı ürün seçenekleri.
                        </p>
                    </div>

                    <hr />

                    <div class="my-4">
                        <h4 class="text-success fw-bold">
                            Kolay Alışveriş
                        </h4>

                        <p class="text-muted mb-0">
                            Sade ve kullanıcı dostu yapısıyla
                            kolay bir alışveriş deneyimi.
                        </p>
                    </div>

                    <hr />

                    <div class="mt-4">
                        <h4 class="text-success fw-bold">
                            Modern Tasarım
                        </h4>

                        <p class="text-muted mb-0">
                            Güncel ve şık tasarımıyla
                            modern bir e-ticaret deneyimi.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- Alt Alan -->
<section class="bg-success text-white py-5">
    <div class="container text-center">

        <h2 class="fw-bold mb-3">
            Tarzını FeyzaStore ile Tamamla
        </h2>

        <p class="mb-4">
            Yeni ürünlerimizi keşfet ve sana uygun parçayı bul.
        </p>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-light px-4">

            Alışverişe Başla

        </a>

    </div>
</section>