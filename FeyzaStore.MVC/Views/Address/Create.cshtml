@model FeyzaStore.MVC.Models.AddressViewModel

@{
    ViewData["Title"] = "Adres Ekle";
}

<div class="container mt-5">
    <h2>Adres Ekle</h2>

    <form asp-controller="Address" asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Adres Başlığı</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="City" class="form-label">Şehir</label>
            <input asp-for="City" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="District" class="form-label">İlçe</label>
            <input asp-for="District" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="FullAddress" class="form-label">Açık Adres</label>
            <textarea asp-for="FullAddress" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="PostalCode" class="form-label">Posta Kodu</label>
            <input asp-for="PostalCode" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">
            Adresi Kaydet
        </button>

    </form>
</div>