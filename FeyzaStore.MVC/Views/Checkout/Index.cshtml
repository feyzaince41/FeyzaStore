@model FeyzaStore.MVC.Models.AddressViewModel

@{
    ViewData["Title"] = "Siparişi Tamamla";
}

<div class="container py-5">

    <h1 class="mb-4">Siparişi Tamamla</h1>

    <h4>Teslimat Adresi</h4>

    <div class="card mt-3">
        <div class="card-body">

            <h5>@Model.Title</h5>

            <p>@Model.FullAddress</p>

            <p>
                @Model.District / @Model.City
            </p>

            <p>
                Posta Kodu: @Model.PostalCode
            </p>

        </div>
    </div>

</div>
<form asp-controller="Checkout"
      asp-action="CreateOrder"
      method="post">

    <input type="hidden"
           name="addressId"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-success btn-lg">
        Siparişi Onayla
    </button>

</form>